{
  "name": "forgeguard-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply forgeguard-demo-tasks --local",
    "db:migrate:remote": "wrangler d1 migrations apply forgeguard-demo-tasks --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.130.0"
  }
}
